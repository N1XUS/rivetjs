# Fake development values only. Never commit a real .env.
# SQLite file (created on first start).
DATABASE_PATH=data/auth.db
PORT=3000
# Public origin used in password reset links (the mail transport logs them to the console).
APP_ORIGIN=http://127.0.0.1:3000
# Safari drops Secure cookies on http://127.0.0.1: set to 1 for a plain `session` cookie in development (refused in production).
# SESSION_COOKIE_INSECURE=1
# Login rate limits: failed attempts per 15 minutes.
# RATE_LIMIT_IP=20
# RATE_LIMIT_ACCOUNT=5
