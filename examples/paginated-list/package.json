{
  "name": "rivet-example-paginated-list",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "rivetExample": {
    "name": "paginated-list",
    "title": "Paginated list from the URL",
    "summary": "A 240-book catalogue: page, page size, sort and search all live in the URL; the loader returns one page; links work without JavaScript.",
    "services": [],
    "backends": [
      "memory"
    ],
    "jsBudgetKB": 40
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr",
    "start": "node serve.ts",
    "check": "rivet sync && rivet-check && node ../../scripts/tsc.ts -p ."
  },
  "dependencies": {
    "@rivetjs/kit": "experimental",
    "@rivetjs/reactivity": "experimental",
    "@rivetjs/router": "experimental",
    "@rivetjs/runtime": "experimental",
    "@rivetjs/ui": "experimental",
    "lucide": "1.52.0"
  },
  "devDependencies": {
    "@rivetjs/compiler": "experimental",
    "@rivetjs/language-core": "experimental",
    "@rivetjs/typescript-plugin": "experimental",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2"
  }
}
