{
  "name": "rivet-example-forms-in-overlays",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "rivetExample": {
    "name": "forms-in-overlays",
    "title": "Forms in drawers and dialogs",
    "summary": "A contacts list: create in a drawer, edit in a modal, delete behind an alert dialog. Overlays keep their state on errors, the list updates in place, and every form works without JavaScript.",
    "services": [],
    "backends": [
      "memory"
    ],
    "jsBudgetKB": 40
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr",
    "start": "node serve.ts",
    "check": "rivet sync && rivet-check && node ../../scripts/tsc.ts -p ."
  },
  "dependencies": {
    "@rivetjs/cdk": "experimental",
    "@rivetjs/forms": "experimental",
    "@rivetjs/kit": "experimental",
    "@rivetjs/reactivity": "experimental",
    "@rivetjs/router": "experimental",
    "@rivetjs/runtime": "experimental",
    "@rivetjs/ui": "experimental",
    "lucide": "1.52.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@rivetjs/compiler": "experimental",
    "@rivetjs/language-core": "experimental",
    "@rivetjs/typescript-plugin": "experimental",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2"
  }
}
