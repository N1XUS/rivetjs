---
import Base from "../../layouts/Base.astro";
import Teasers from "../../components/Teasers.astro";
import { articles, site } from "../../lib/site.mjs";
export async function getStaticPaths() {
  const { site } = await import("../../lib/site.mjs");
  return site.tags.map((tag) => ({ params: { tag } }));
}
const { tag } = Astro.params;
const items = (await articles()).filter((a) => a.tags.includes(tag)).slice(0, site.listLimit);
---
<Base title={`Tag: ${tag}`} description={`Stories tagged ${tag}.`}><main class="list"><h1>Tag: {tag}</h1><Teasers items={items} /></main></Base>
