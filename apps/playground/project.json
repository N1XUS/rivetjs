{
  "name": "playground",
  "projectType": "application",
  "implicitDependencies": ["compiler", "runtime", "reactivity", "router"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node apps/playground/build.ts" }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": { "command": "vitest run --project playground" }
    },
    "sync": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node libs/router/cli/rivet.ts sync --root apps/playground" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync"],
      "cache": false,
      "options": { "command": "node scripts/tsc.ts -p apps/playground" }
    },
    "rivet-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync"],
      "cache": false,
      "options": { "command": "node libs/language-core/cli.ts -p apps/playground/tsconfig.json" }
    },
    "latency": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": { "command": "node apps/playground/latency.ts" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node apps/playground/server.ts" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node apps/playground/server.ts --dev" }
    }
  }
}
