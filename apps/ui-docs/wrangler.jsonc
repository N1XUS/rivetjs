{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rivetjs-ui",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/cloudflare/site",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "ui.rivetjs.severyn.pro", "custom_domain": true }],
}
