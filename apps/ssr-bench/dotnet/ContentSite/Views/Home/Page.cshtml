@model Rivet.ContentSite.PageModel
@{ Layout = null; }
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@Model.Page.Title</title><style>body{font:16px system-ui;margin:24px;color:#172033;background:#f8fafc}section[data-grid]{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}article{background:white;border:1px solid #cbd5e1;padding:12px;border-radius:6px}dl>div{display:flex;justify-content:space-between}dt,dd{margin:0}footer{display:flex;gap:12px}</style></head><body><main data-token="@Model.Page.Token"><h1>@Model.Page.Title</h1>@if(Model.Page.Markdown.Length > 0){<div data-article="">@Model.Article</div>}<section data-grid="">@foreach(var row in Model.Page.Rows){<article data-row="@row.Id" data-state="even"><header><h2>Record</h2><p>Static description and supporting HTML.</p></header><section><dl>@for(var i=0;i<10;i++){<div><dt>Field @i</dt><dd>@if(row.TextValues.Count > 0){@row.TextValues[i]}else{@row.Values[i]}</dd></div>}</dl></section><footer><button type="button" disabled>Increment</button><label>Selected<input type="checkbox" readonly></label></footer></article>}</section></main><!--complete--></body></html>
