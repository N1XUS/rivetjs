{
  "name": "cdk-docs",
  "projectType": "application",
  "implicitDependencies": [
    "cdk",
    "kit",
    "docs-kit",
    "compiler",
    "runtime",
    "reactivity",
    "router",
    "i18n",
    "devtools"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/docs-kit/cli.ts build apps/cdk-docs"
      }
    },
    "examples": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/docs-kit/cli.ts examples apps/cdk-docs"
      }
    },
    "api": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/docs-kit/cli.ts api apps/cdk-docs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/docs-kit/cli.ts prepare apps/cdk-docs && node scripts/tsc.ts -p apps/cdk-docs"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/docs-kit/cli.ts serve apps/cdk-docs --dev"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/docs-kit/cli.ts serve apps/cdk-docs"
      }
    }
  }
}
