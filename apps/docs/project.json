{
  "name": "docs",
  "projectType": "application",
  "implicitDependencies": ["docs-kit", "compiler", "runtime", "reactivity", "router", "i18n", "devtools"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node libs/docs-kit/cli.ts build apps/docs" }
    },
    "examples": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node libs/docs-kit/cli.ts examples apps/docs" }
    },
    "api": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node libs/docs-kit/cli.ts api apps/docs" }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": { "command": "vitest run --project docs" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node libs/docs-kit/cli.ts prepare apps/docs && node scripts/tsc.ts -p apps/docs" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node libs/docs-kit/cli.ts serve apps/docs --dev" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node libs/docs-kit/cli.ts serve apps/docs" }
    }
  }
}
