{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rivetjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "rivetjs.severyn.pro", "custom_domain": true }]
}
