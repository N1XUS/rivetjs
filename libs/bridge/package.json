{
  "name": "@rivetjs/bridge",
  "version": "0.1.0-alpha.2",
  "description": "Framework bridges for Rivet: React, Preact, Solid, Vue and Svelte islands inside a resumable page.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "rivet": {
    "source": true
  },
  "imports": {
    "#dev": {
      "types": "./dev-off.ts",
      "development": "./dev-on.ts",
      "default": "./dev-off.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./server": {
      "types": "./server.tsx",
      "default": "./server.tsx"
    },
    "./dom": {
      "types": "./dom.tsx",
      "default": "./dom.tsx"
    },
    "./client": {
      "types": "./client.ts",
      "default": "./client.ts"
    },
    "./intent": {
      "types": "./intent.ts",
      "default": "./intent.ts"
    },
    "./vite": {
      "types": "./vite.ts",
      "default": "./vite.ts"
    },
    "./adapter": {
      "types": "./adapter.ts",
      "default": "./adapter.ts"
    },
    "./head": {
      "types": "./head.ts",
      "default": "./head.ts"
    },
    "./head-client": {
      "types": "./head-client.ts",
      "default": "./head-client.ts"
    }
  },
  "peerDependencies": {
    "@rivetjs/compiler": "0.1.0-alpha.2",
    "@rivetjs/reactivity": "0.1.0-alpha.2",
    "@rivetjs/runtime": "0.1.0-alpha.2",
    "vite": "^8.3.2"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/libs/bridge"
  }
}
