{
  "name": "bridge-solid",
  "projectType": "library",
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node scripts/package/build.ts libs/bridge-solid" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "vitest run --project bridge-solid --project bridge-solid-browser --passWithNoTests" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node scripts/tsc.ts -p libs/bridge-solid" }
    }
  }
}
