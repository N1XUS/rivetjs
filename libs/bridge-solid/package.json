    },
    "./server": {
      "types": "./server.ts",
      "default": "./server.ts"
    },
    "./client": {
      "types": "./client.ts",
      "default": "./client.ts"
    },
    "./vite": {
      "types": "./vite.ts",
      "default": "./vite.ts"
    },
    "./types": {
      "types": "./types.ts",
      "default": "./types.ts"
    }
  },
  "peerDependencies": {
    "@rivetjs/bridge": "0.1.0-alpha.2",
    "solid-js": ">=1.9.0 <2",
