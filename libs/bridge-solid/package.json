{
  "name": "@rivetjs/bridge-solid",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "description": "Solid 1.9 islands for Rivet: server rendering, hydration policies, reactive props and resumable slots.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
