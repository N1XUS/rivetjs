  },
  "devDependencies": {
    "solid-js": "1.9.15",
    "vite-plugin-solid": "2.11.14"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/libs/bridge-solid"
  }
