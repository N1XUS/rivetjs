{
  "name": "runtime",
  "projectType": "library",
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node scripts/package/build.ts libs/runtime" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --project runtime --project runtime-dev"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/tsc.ts -p libs/runtime"
      }
    }
  }
}
