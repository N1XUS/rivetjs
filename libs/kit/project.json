{
  "name": "kit",
  "projectType": "library",
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node scripts/package/build.ts libs/kit" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "vitest run --project kit --project kit-browser" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node scripts/tsc.ts -p libs/kit" }
    }
  }
}
