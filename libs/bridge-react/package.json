{
  "name": "@rivetjs/bridge-react",
  "version": "0.1.0-alpha.0",
  "description": "React 19 islands for Rivet: server render into the stream, hydrate on a client policy, live props, slots.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./server": {
      "types": "./server.ts",
      "default": "./server.ts"
    },
    "./client": {
      "types": "./client.ts",
      "default": "./client.ts"
    },
    "./vite": {
      "types": "./vite.ts",
      "default": "./vite.ts"
    },
    "./types": {
      "types": "./types.ts",
      "default": "./types.ts"
    }
  },
  "peerDependencies": {
    "@rivetjs/bridge": "0.1.0-alpha.0",
    "@vitejs/plugin-react": ">=6.0.0 <7",
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/libs/bridge-react"
  }
}
