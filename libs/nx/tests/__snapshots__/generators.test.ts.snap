exports[`layout > guarded group layout; root layout exists already 1`] = `
"import { redirect, type LayoutProps, type RequestEvent } from "@rivetjs/router";

/** Runs for every page and endpoint in this folder, before their loaders. */
export const serverGuard = ({ cookies, url }: RequestEvent) => {
  if (!cookies.get("session")) return redirect("/login?next=" + encodeURIComponent(url.pathname));
};

/** Wraps every page in src/routes/(private). Stays mounted across client navigation between them. */
export default function PrivateLayout({ children }: LayoutProps) {
  return <div class="private-layout">{children}</div>;
}
"
`;

