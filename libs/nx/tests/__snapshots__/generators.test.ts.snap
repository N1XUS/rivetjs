exports[`component > overlay: render-function children, inline handlers; story route 1`] = `
"import { signal } from "@rivetjs/reactivity";
import type { Slot } from "@rivetjs/runtime/jsx-runtime";

export interface PopoverProps {
  /** Trigger text (also the panel's accessible name). */
  label: string;
  /**
   * Render-function children (\`{() => <p>…</p>}\`): the content of the closed panel is created when it opens, also on a
   * resumed page. Plain JSX children would be created right away and kept for later, which a resumed page cannot save.
   */
  children: Slot;
}

/** Popover: a trigger and a panel that opens below it. Handlers are inline arrows (resumable). */
export function Popover(props: PopoverProps) {
  const open = signal(false);
  return (
    <div class="popover">
      <button type="button" aria-expanded={open() ? "true" : "false"} onClick={() => open.update((value) => !value)}>
        {props.label}
      </button>
      {open() && (
        <div role="dialog" aria-label={props.label}>
          {props.children()}
          <button type="button" onClick={() => open.set(false)}>
            Close
          </button>
        </div>
      )}
    </div>
  );
}
"
`;

exports[`component > overlay: render-function children, inline handlers; story route 2`] = `
"import { Popover } from "../../overlays/Popover.tsx";

export const head = { title: "Popover story" };

/** Story page of Popover (/stories/popover): its states side by side. */
export default function PopoverStory() {
  return (
    <main>
      <h1>Popover</h1>
      <section>
        <h2>Default</h2>
        <Popover label="Open">{() => <p>Panel content</p>}</Popover>
      </section>
      <section>
        <h2>With content</h2>
        <Popover label="More">
          {() => (
            <ul>
              <li>One</li>
              <li>Two</li>
            </ul>
          )}
        </Popover>
      </section>
    </main>
  );
}
"
`;

exports[`i18n-setup > config, catalogs, plugin first, gitignored dts 1`] = `
"import type { I18nRouteConfig } from "@rivetjs/i18n/router";

// Locales (the default first), ICU catalogs per locale, and how the locale appears in URLs. Used by the i18n() Vite
// plugin (vite.config.ts) and by \`i18nGuard(config)\` in a \`[[lang]]\` layout (see the Locale URLs guide).
export const config = {
  locales: ["en", "de"],
  defaultLocale: "en",
  catalogs: "locales/{locale}.json",
  routing: { prefix: "always" },
} satisfies I18nRouteConfig & { catalogs: string };
"
`;

