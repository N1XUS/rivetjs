exports[`component > basic component + test in an app 1`] = `
"import { signal } from "@rivetjs/reactivity";
import type { Content } from "@rivetjs/runtime/jsx-runtime";

export interface UserCardProps {
  /** Button text. */
  label?: string;
  children?: Content;
}

/**
 * UserCard. The click handler is an inline arrow: the compiler captures it, so on a resumed page the button
 * works without running the component in the browser (its code loads on first interaction).
 */
export function UserCard(props: UserCardProps) {
  const count = signal(0);
  return (
    <div class="user-card">
      {props.children}
      <button type="button" onClick={() => count.update((n) => n + 1)}>
        {props.label ?? "Clicked"} {count()}
      </button>
    </div>
  );
}
"
`;

