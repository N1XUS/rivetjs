exports[`api-route > handlers per method; static apps refused 1`] = `
"import type { RequestEvent } from "@rivetjs/router";

/** \`GET /api/items/:id\`. Runs only on the server; must return a \`Response\`. */
export const onGet = async ({ params }: RequestEvent) => {
  return Response.json({ ok: true, params }, { headers: { "cache-control": "no-store" } });
};

/** \`POST /api/items/:id\`. Runs only on the server; must return a \`Response\`. */
export const onPost = async ({ request, params }: RequestEvent) => {
  const body: unknown = await request.json().catch(() => null);
  return Response.json({ ok: true, params, body }, { status: 201 });
};

/** \`DELETE /api/items/:id\`. Runs only on the server; must return a \`Response\`. */
export const onDelete = async ({ params }: RequestEvent) => {
  console.log("delete", params);
  return new Response(null, { status: 204 });
};
"
`;

