{
  "name": "@rivetjs/bridge-vue",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "description": "Vue 3.5 islands for Rivet: async SSR, policy hydration, live props and resumable slots.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./server": {
      "types": "./server.ts",
      "default": "./server.ts"
    },
    "./client": {
      "types": "./client.ts",
      "default": "./client.ts"
    },
    "./vite": {
      "types": "./vite.ts",
      "default": "./vite.ts"
    },
    "./types": {
      "types": "./types.ts",
      "default": "./types.ts"
    }
  },
  "peerDependencies": {
    "@rivetjs/bridge": "0.1.0-alpha.2",
    "@vitejs/plugin-vue": ">=6.0.0 <7",
    "vue": ">=3.5.0 <4"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/server-renderer": "3.5.43",
    "vue": "3.5.43"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/libs/bridge-vue"
  }
}
