{
  "name": "cdk",
  "projectType": "library",
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node scripts/package/build.ts libs/cdk" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/vitest-seq.ts \"--project cdk --project cdk-dev --maxWorkers=2\" \"--project cdk-browser\" \"--project cdk-components\""
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/tsc.ts -p libs/cdk"
      }
    }
  }
}
