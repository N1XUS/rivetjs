{
  "name": "reactivity",
  "projectType": "library",
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node scripts/package/build.ts libs/reactivity" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --project reactivity --project reactivity-dev"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/tsc.ts -p libs/reactivity"
      }
    }
  }
}
