{
  "name": "compiler",
  "projectType": "library",
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node scripts/package/build.ts libs/compiler" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --project compiler"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/tsc.ts -p libs/compiler"
      }
    },
    "parity": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/compiler/oracle/check.ts"
      }
    }
  }
}
