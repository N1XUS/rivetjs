  "scripts": {
    "rivet-profile-server.mjs": "import { Session } from 'node:inspector';\nimport { writeFile } from 'node:fs/promises';\nawait import('/workspace/apps/ssr-bench/server.mjs');\nconst session=new Session();session.connect();\nconst post=method=>new Promise((resolve,reject)=>session.post(method,(error,data)=>error?reject(error):resolve(data)));\nlet active=false,busy=false,index=0,cpu,start;\nprocess.on('SIGUSR2',async()=>{\n if(busy)return;busy=true;\n try{\n  if(!active){await post('Profiler.enable');await post('Profiler.start');cpu=process.cpuUsage();start=performance.now();active=true;console.log('PROFILE_STARTED',index);}\n  else {const {profile}=await post('Profiler.stop');const usage=process.cpuUsage(cpu);await writeFile(`/evidence/request-${index}.cpuprofile`,JSON.stringify(profile));await writeFile(`/evidence/request-${index}-control.json`,JSON.stringify({cpuMs:(usage.user+usage.system)/1000,wallMs:performance.now()-start,samples:profile.samples.length}));console.log('PROFILE_SAVED',index++);active=false;}\n }catch(error){console.error(error);process.exitCode=1;}finally{busy=false;}\n});\nconsole.log('PROFILE_READY');\n",
    "rivet-request-profile-driver.mjs": "import {execFileSync} from 'node:child_process';\nimport {writeFile,readFile} from 'node:fs/promises';\nconst name='rivet-ssr-profile-e9aa38b';const base='http://127.0.0.1:18109';\nconst docker=(...args)=>execFileSync('docker',args,{encoding:'utf8'});\nconst pause=ms=>new Promise(resolve=>setTimeout(resolve,ms));\nasync function waitLog(marker){for(let i=0;i<200;i++){if(docker('logs',name).includes(marker))return;await pause(50);}throw Error('Missing '+marker);}\nasync function page(rows,token){const response=await fetch(`${base}/page?rows=${rows}&token=${token}`,{signal:AbortSignal.timeout(15000)});const body=await response.text();if(response.status!==200||(body.match(/<dd\\b/g)||[]).length!==rows*10||!body.includes(`data-token=\"${token}\"`)||!body.includes('<!--complete-->'))throw Error('Invalid page');return Buffer.byteLength(body);}\nconst results=[];\ntry{\n await waitLog('PROFILE_READY');\n for(const [index,rows,count] of [[0,1000,500],[1,5000,200]]){\n  for(let i=0;i<20;i++)await page(rows,`warm-${rows}-${i}`);\n  const before=await(await fetch(base+'/metrics')).json();\n  docker('kill','--signal=USR2',name);await waitLog('PROFILE_STARTED '+index);\n  let totalBytes=0;\n  for(let i=0;i<count;i++)totalBytes+=await page(rows,`profile-${rows}-${i}`);\n  docker('kill','--signal=USR2',name);await waitLog('PROFILE_SAVED '+index);\n  const after=await(await fetch(base+'/metrics')).json();\n  const control=JSON.parse(await readFile(`.artifacts/ssr-bench/task7-request-profile/request-${index}-control.json`));\n  const counters=Object.fromEntries(['completed','failed','cancelled','rpcMs','parseMs','renderMs'].map(k=>[k,after[k]-before[k]]));\n  if(counters.completed!==count||counters.failed||counters.cancelled)throw Error('Counter mismatch');\n  const result={index,rows,requests:count,totalBytes,counters,control};results.push(result);console.log(JSON.stringify(result));\n }\n await writeFile('.artifacts/ssr-bench/task7-request-profile/requests.json',JSON.stringify(results,null,2)+'\\n');\n}finally{docker('stop',name);}\n"
  },
